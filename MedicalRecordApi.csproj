<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	  <PlaywrightIncludeBrowsers>true</PlaywrightIncludeBrowsers>
  </PropertyGroup>
	

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.11.1" />
    <PackageReference Include="DinkToPdf" Version="1.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Playwright" Version="1.56.0" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.7" />
    <PackageReference Include="MySql.Data" Version="8.4.0" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="PuppeteerSharp" Version="20.2.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="System.Management" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Horizon.Repository.ADS">
      <HintPath>..\..\..\..\..\lib\Horizon.Repository.ADS.dll</HintPath>
    </Reference>
    <Reference Include="Horizon.Repository.ECW">
      <HintPath>..\..\..\..\..\lib\Horizon.Repository.ECW.dll</HintPath>
    </Reference>
    <Reference Include="InterSystems.Data.CacheClient">
      <HintPath>..\..\..\..\..\lib\InterSystems.Data.CacheClient.dll</HintPath>
    </Reference>
    <Reference Include="MySql.Data">
      <HintPath>..\..\..\..\..\lib\MySql.Data.dll</HintPath>
    </Reference>
	  
  </ItemGroup>

  <ItemGroup>
    <None Include="DinkToPdf\**\*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
